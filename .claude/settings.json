{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(npm run build*)",
      "Bash(npm install*)",
      "Bash(python*)",
      "Bash(pip install*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Bash(git push --force*)"
    ]
  }
}
