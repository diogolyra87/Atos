# .env.example - placeholders para o monitor IMAP do e-SAJ TJSP (backend/esaj_imap.py).
# Este arquivo NAO e um template completo do .env real do projeto - so cobre
# as chaves novas dessa automacao. Preencha os valores reais em /root/atos/.env
# (producao) e no .env local, nunca neste arquivo de exemplo.

# Conexao IMAP da caixa que recebe os emails do e-SAJ TJSP
ESAJ_IMAP_HOST=
ESAJ_IMAP_PORT=993
ESAJ_IMAP_USER=
ESAJ_IMAP_PASS=

# Pastas IMAP (a de processados e criada automaticamente se nao existir)
ESAJ_IMAP_PASTA_ORIGEM=INBOX
ESAJ_IMAP_PASTA_PROCESSADOS=Processados

# Filtros de busca (opcionais, mas recomendados para nao processar email errado)
ESAJ_REMETENTE_FILTRO=
ESAJ_ASSUNTO_FILTRO=certidão

# Destinatarios do reenvio (Enel), separados por virgula
ESAJ_DESTINATARIOS_ENEL=
