# .env.example - placeholders das chaves novas adicionadas por automacoes.
# Este arquivo NAO e um template completo do .env real do projeto - cada secao
# cobre so as chaves novas de uma automacao especifica. Preencha os valores
# reais em /root/atos/.env (producao) e no .env local, nunca neste arquivo.

# --- Monitor IMAP do e-SAJ TJSP (backend/esaj_imap.py) ---

# Conexao IMAP da caixa que recebe os emails do e-SAJ TJSP
ESAJ_IMAP_HOST=
ESAJ_IMAP_PORT=993
ESAJ_IMAP_USER=
ESAJ_IMAP_PASS=

# Pastas IMAP (a de processados e criada automaticamente se nao existir)
ESAJ_IMAP_PASTA_ORIGEM=INBOX
ESAJ_IMAP_PASTA_PROCESSADOS=Processados

# Filtros de busca (opcionais, mas recomendados para nao processar email errado)
ESAJ_REMETENTE_FILTRO=
ESAJ_ASSUNTO_FILTRO=certidão

# Destinatarios do reenvio (Enel), separados por virgula
ESAJ_DESTINATARIOS_ENEL=

# --- Integracao Infosimples para JUCESP (automacao/jucesp_infosimples.py) ---
# Cobre so ficha cadastral e download de documento - NAO acompanhamento de
# status, que ja e gratis via automacao/consultar_jucesp.py (scraping publico).

# Token da conta Infosimples (api.infosimples.com)
INFOSIMPLES_TOKEN=

# Credenciais de login usadas pela Infosimples pra acessar a JUCESP (CPF do
# responsavel + senha da Nota Fiscal Paulista - credencial separada do
# login gov.br, NAO e a senha do gov.br)
INFOSIMPLES_CPF=
INFOSIMPLES_SENHA_NFP=

# Modo teste do job piloto (automacao/teste_jucesp_infosimples.py): quando
# true (padrao), TODA notificacao desse fluxo e redirecionada pro e-mail do
# administrador, com aviso de quem seria o destinatario real. Trocar pra
# false quando confirmar que esta tudo certo pra ir de fato ao cliente -
# nao precisa mexer no codigo, so essa variavel.
ESCLARA_MODO_TESTE=true
